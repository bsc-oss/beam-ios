#!/bin/bash

export PATH="$PATH:/opt/homebrew/bin"

if ! swiftformat --lint . > /dev/null 2>&1
then
  echo "pre-commit: Commit aborted due to SwiftFormat warnings. Please check the automatically generated fixes and try again"
  swiftformat . > /dev/null 2>&1
  exit 1
fi

# PG_CHANGED - upstream removed acknowledgement generation from pre-commit; PG keeps it to maintain Settings.bundle licences + element-x-ios.plist
swift-package-list ElementX.xcodeproj --requires-license --ignore-package compound-ios --ignore-package compound-design-tokens --ignore-package matrix-rich-text-editor-swift --ignore-package element-call-swift --output-type settings-bundle --output-path ElementX/SupportingFiles

# PG_CHANGED - Adds element-x-ios acknowledgement
cp Tools/AcknowledgementTemplates/element-x-ios.plist ElementX/SupportingFiles/Settings.bundle/Packages/
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:1 dict" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:1:File string 'Packages/element-x-ios'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:1:Title string 'Element X iOS'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:1:Type string 'PSChildPaneSpecifier'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist

# PG_CHANGED - Adds the Poppins acknowledgement, the font isn't a package so swift-package-list can't pick it up.
# The packages are listed alphabetically, so look for the first one sorting after Poppins and insert it there.
# Index 0 is the Licenses group and index 1 the Element X iOS entry added above, both of which are skipped.
POPPINS_INDEX=2
while TITLE=$(/usr/libexec/PlistBuddy -c "Print :PreferenceSpecifiers:$POPPINS_INDEX:Title" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist 2>/dev/null)
do
  if [[ "$(echo "$TITLE" | tr '[:upper:]' '[:lower:]')" > "poppins" ]]; then break; fi
  POPPINS_INDEX=$((POPPINS_INDEX + 1))
done

cp Tools/AcknowledgementTemplates/Poppins.plist ElementX/SupportingFiles/Settings.bundle/Packages/
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:$POPPINS_INDEX dict" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:$POPPINS_INDEX:File string 'Packages/Poppins'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:$POPPINS_INDEX:Title string 'Poppins'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist
/usr/libexec/PlistBuddy -c "Add :PreferenceSpecifiers:$POPPINS_INDEX:Type string 'PSChildPaneSpecifier'" ElementX/SupportingFiles/Settings.bundle/Acknowledgements.plist

if ! git diff --quiet -- ./ElementX/SupportingFiles/Settings.bundle || [ -n "$(git ls-files --others --exclude-standard -- ./ElementX/SupportingFiles/Settings.bundle)" ]; then
  echo "pre-commit: Commit aborted due to unstaged changes to the package Acknowledgements."
  exit 1
fi

./Tools/Scripts/validate_lfs.sh