<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(APS_ENV)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- PG_CHANGED - use single configurable $(ASSOCIATED_DOMAIN); dropped hardcoded element.io/matrix.to domains -->
		<string>webcredentials:$(ASSOCIATED_DOMAIN)</string>
		<string>applinks:$(ASSOCIATED_DOMAIN)</string>
	</array>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_IDENTIFIER)</string>
		<!-- PG_CHANGED - removed $(CLASSIC_APP_GROUP_IDENTIFIER): classic-app import disabled for Beam (would otherwise expand to empty group and break signing) -->
	</array>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(KEYCHAIN_ACCESS_GROUP_IDENTIFIER)</string>
		<!-- PG_CHANGED - removed $(CLASSIC_APP_KEYCHAIN_ACCESS_GROUP_IDENTIFIER): classic-app import disabled for Beam (would otherwise expand to empty keychain group and break signing) -->
	</array>
</dict>
</plist>
